# ============================================================
#  Veda AI settings
#  1. Copy this file to a new file named  .env
#  2. Paste your Groq API key below (free: https://console.groq.com/keys)
#  3. Save. Run:  python app.py
#  Do not put spaces around "=" and do not add comments after a value.
# ============================================================

# --- Required: your own Groq API key (looks like gsk_...) ---
GROQ_API_KEY=

# --- Server ---
# PORT is the number in http://localhost:5000
PORT=5000
# 127.0.0.1 = only this device can open the app (safest, default)
# 0.0.0.0   = other devices on your Wi-Fi / hotspot can open it too
HOST=127.0.0.1
# Optional password (any username). Strongly recommended if HOST=0.0.0.0
APP_PASSWORD=

# --- Branding (shown in the sidebar; leave APP_NAME empty to hide the text) ---
APP_NAME=Veda AI
APP_TAGLINE=Your team of minds

# --- Models. Groq renames models often. If you see "model does not exist",
#     open the Groq playground model list and put the current name here.
#     No restart is needed after editing.
MODEL_SUTRA=openai/gpt-oss-20b
MODEL_SHLOKA=qwen/qwen3.8-27b
MODEL_VEDA=openai/gpt-oss-120b
MODEL_SARATHI=openai/gpt-oss-20b
MODEL_DRISHTI=qwen/qwen3.8-27b
MODEL_SHRUTI=whisper-large-v3-turbo

# --- Which level each agent uses: sutra (fast), shloka (balanced), veda (deep) ---
LEVEL_VISHWAKARMA=veda
LEVEL_SARASWATI=shloka
LEVEL_VALMIKI=shloka
LEVEL_CHANAKYA=veda
LEVEL_ARYABHATA=veda
LEVEL_DRONACHARYA=shloka
LEVEL_DHANVANTARI=veda
LEVEL_KUBERA=veda
LEVEL_VIDURA=veda
LEVEL_PANINI=shloka
LEVEL_NARADA=sutra
LEVEL_SANJAYA=sutra
LEVEL_CHITRAGUPTA=sutra

# --- Database file name (stored next to app.py) ---
DB_PATH=memory.db
